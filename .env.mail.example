# ============================================
# 📧 CONFIGURATION EMAIL - BREVO
# ============================================

# Mailer Driver: smtp (pour Brevo)
# - log: Stocke les emails dans storage/logs (développement)
# - smtp: Envoie via SMTP (Brevo recommandé)
MAIL_MAILER=smtp

# SMTP Configuration - BREVO
# 1. Générer une clé SMTP sur https://app.brevo.com/settings/account/smtp
# 2. Remplacer les valeurs ci-dessous
MAIL_SCHEME=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_password

# Email "From"
MAIL_FROM_ADDRESS="noreply@afrishop.com"
MAIL_FROM_NAME="AfriShop"

# ============================================
# 🔄 CONFIGURATION QUEUE
# ============================================

# Queue Driver: sync, database, redis, sqs
# - sync: Synchrone (teste rapide, pas de worker nécessaire)
# - database: Enregistre dans table 'jobs' (recommandé)
QUEUE_CONNECTION=database

# ============================================
# 🌐 URL FRONTEND
# ============================================

# URL pour les liens dans les emails
FRONTEND_URL=http://localhost:3000

# ============================================
# 📝 INSTRUCTIONS - Configuration Brevo
# ============================================

# ✅ Étapes pour ajouter une clé SMTP Brevo :
# 
# 1. Accédez à https://app.brevo.com
# 2. Allez à Paramètres → Compte → SMTP
# 3. Cliquez sur "Générer une nouvelle clé SMTP"
# 4. Copier le nom d'utilisateur SMTP
# 5. Copier le mot de passe SMTP (généré automatiquement)
# 6. Remplacer MAIL_USERNAME et MAIL_PASSWORD ci-dessus
#
# Configuration Brevo prête à l'emploi :
# MAIL_SCHEME=tls
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=votre_email@exemple.com
# MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxx-xxxxxxxxxxxxx
#
# ℹ️  Avantages de Brevo :
# - 300 emails/jour gratuits
# - Interface et SDK intuitifs
# - Support multilingue
# - Fiable et rapide
# - Statistiques d'envoi en temps réel
